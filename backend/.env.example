# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# MONGO_URI=mongodb://localhost:27017/lanting

# CORS Configuration
CORS_ORIGIN=http://localhost:8000

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1d

# Single-File-CLI Configuration
USE_SINGLEFILE_DOCKER=false
# 如果留空，将自动使用 Puppeteer 提供的 Chromium 浏览器
# BROWSER_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# Archives Configuration
# ARCHIVES_ROOT_DIR=E:\\path\\to\\your\\archives  # 自定义archives根目录
# ARCHIVES_URL_PATH=/archives                     # 访问URL路径
